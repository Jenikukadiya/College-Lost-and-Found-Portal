{
  "name": "college-lost-and-found-portal",
  "version": "1.0.0",
  "description": "College Lost & Found Portal - Web-based Software Engineering Project",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "seed": "node database/seed.js",
    "test": "jest tests/authPermissions.test.js tests/claimService.test.js tests/itemValidation.test.js tests/reportValidation.test.js --verbose",
    "test:unit": "jest tests/authPermissions.test.js tests/claimService.test.js tests/itemValidation.test.js tests/reportValidation.test.js --verbose",
    "test:integration": "node database/init_test_db.js && NODE_ENV=test jest tests/integration/ --verbose --runInBand --forceExit",
    "test:all": "npm test && npm run test:integration",
    "test:legacy": "node test/test_suite.js",
    "db:start": "/usr/local/mysql/bin/mysqld --datadir=\"./database/datadir\" --port=3307 --socket=\"./database/mysql.sock\" --mysqlx=OFF &"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
