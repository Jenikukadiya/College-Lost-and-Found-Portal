# ==========================================
# Dependencies
# ==========================================
node_modules/
package-lock.json.backup

# ==========================================
# Environment Variables & Secrets
# ==========================================
# Never commit actual secret keys or database passwords
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# ==========================================
# Local Database Storage & Runtime Sockets
# ==========================================
# MySQL internal datadir, runtime sockets, and locks
database/datadir/
database/mysql.sock*
*.sock
*.sock.lock

# ==========================================
# User Uploads
# ==========================================
# Exclude uploaded item photos while keeping folder tracked
uploads/*
!uploads/.gitkeep

# ==========================================
# Logs & Process Artifacts
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Test Coverage & Reporting
# ==========================================
coverage/
.nyc_output/

# ==========================================
# Operating System & IDE Files
# ==========================================
.DS_Store
.DS_Store?
._*
[Tt]humbs.db
ehthumbs.db

# IDE / Editor configuration
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ==========================================
# Temporary Files & Scratch Notes
# ==========================================
*.tmp
*.temp
scratch/
